---
import Base from '../layouts/Base.astro';
import { contexto } from '../lib/contexto';
import { ruta } from '../lib/formato';
import { ELECCIONES_HISTORICAS, fichaDe, vistaDe } from '../lib/historico';
import { colorGrupo } from '../lib/recuento/colores';
import { renderHemiciclo } from '../lib/recuento/hemiciclo';
import { numero, porcentaje } from '../lib/recuento/html';
import { renderPaneles } from '../lib/recuento/paneles';
import { indiceInicial, nocheSimulada, ORDENES } from '../lib/simulacion';

const { fase } = contexto();

// Miniaturas: el reparto final de cada elección en un hemiciclo, el del ejemplo de recuento y un hemiciclo vacío para las
// elecciones que aún no han ocurrido.
const noche = nocheSimulada(ORDENES[0] as (typeof ORDENES)[number]);
const miniaturaEjemplo = renderPaneles(noche.vistas[indiceInicial(noche)] as (typeof noche.vistas)[number]).sectoresGrupos;
const miniaturaVacia = renderHemiciclo({ total: 350 });

const elecciones = ELECCIONES_HISTORICAS.map((e) => {
  const vista = vistaDe(e);
  const grupos = vista.grupos.filter((g) => g.escanos > 0);
  const ficha = fichaDe(e.datos);
  const miniatura = renderHemiciclo({
    total: ficha.escanos,
    grupos: grupos.map((g) => ({ nombre: g.nombre, color: colorGrupo(g.id), escanos: g.escanos })),
  });
  const [primero, segundo, tercero] = grupos;
  const siguientes = [segundo, tercero].filter((g) => g !== undefined).map((g) => `${g.nombre} (${numero(g.escanos)})`);
  const resumen =
    `Más escaños: ${primero?.nombre} (${numero(primero?.escanos ?? 0)}).` +
    (siguientes.length > 0 ? ` Le siguen ${siguientes.join(' y ')}.` : '') +
    ` Participación: ${porcentaje(ficha.participacion)}.`;
  return { e, miniatura, resumen };
});
---

<Base
  titulo="Histórico"
  descripcion="Recuento final de las tres últimas elecciones generales (abril y noviembre de 2019 y julio de 2023) y un ejemplo de recuento para ver cómo funcionan los paneles."
  fase={fase}
>
  <section class="hero">
    <h1>Histórico</h1>
    <p class="lead">
      El recuento final y el análisis de las elecciones generales pasadas, para volver a verlos cuando quieras. Las del 29N
      se guardarán aquí cuando termine el recuento.
    </p>
  </section>

  <ul class="historico">
    <li class="entrada-historico entrada-historico--pendiente">
      <div class="miniatura miniatura--vacia" aria-hidden="true" set:html={miniaturaVacia} />
      <div>
        <h2>Elecciones generales del 29N de 2026</h2>
        <p>El recuento y el análisis estarán aquí cuando termine el escrutinio.</p>
        <span class="chip chip--suave">Próximamente</span>
      </div>
    </li>
    {
      elecciones.map(({ e, miniatura, resumen }) => (
        <li class="entrada-historico">
          <div class="miniatura" aria-hidden="true" set:html={miniatura} />
          <div>
            <h2>
              <a href={ruta(`historico/${e.id}/`)}>{e.titulo}</a>
            </h2>
            <p>{resumen}</p>
            <span class="chip chip--suave">Recuento final</span>
          </div>
        </li>
      ))
    }
  </ul>

  <h2>Para probar los paneles</h2>
  <ul class="historico historico--aparte">
    <li class="entrada-historico">
      <div class="miniatura" aria-hidden="true" set:html={miniaturaEjemplo} />
      <div>
        <h3><a href={ruta('simulacion/')}>Ejemplo de recuento</a></h3>
        <p>
          Una noche electoral simulada con los votos de las generales de 2023, para ver cómo funcionan los paneles. No son
          resultados de 2026.
        </p>
        <span class="chip">Ejemplo</span>
      </div>
    </li>
  </ul>
</Base>
