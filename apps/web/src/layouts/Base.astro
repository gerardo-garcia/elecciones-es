---
import '@fontsource-variable/schibsted-grotesk';
import '../styles/global.css';
import Anuncio from '../components/Anuncio.astro';
import titularJson from '../data/titular.json';
import { ANCHO_MINIMO_LATERALES, ANUNCIOS, exigirTitular, muestraAnuncios, urlScriptAnuncios } from '../lib/anuncios';
import { CALENDARIO } from '../lib/calendario';
import { ruta } from '../lib/formato';
import type { Fase } from '../lib/fase';
import { renderHemiciclo } from '../lib/recuento/hemiciclo';

interface Props {
  titulo: string;
  descripcion?: string;
  fase: Fase;
  /** true solo en la portada ('/'): el script de cliente la redirige si la fase ya cambió. */
  portada?: boolean;
  /** Páginas que no deben aparecer en los buscadores (la 404). */
  noindex?: boolean;
}

const etiquetaFase: Record<Fase, string> = {
  previa: 'Antes de las elecciones',
  recuento: 'Recuento en directo',
  analisis: 'Análisis',
};

const {
  titulo,
  descripcion = 'Seguimiento de las elecciones generales del 29 de noviembre de 2026: encuestas, recuento en directo y análisis de resultados.',
  fase,
  portada = false,
  noindex = false,
} = Astro.props;

const inicio = ruta('/');
const rutaHistorico = ruta('historico/');
const rutaEjemplo = ruta('simulacion/');
const actual = Astro.url.pathname;
// En la página del ejemplo se resalta «Ejemplo de recuento»; en el histórico y en lo que cuelga de él, «Histórico».
const enHistorico = actual === rutaHistorico;
const enEjemplo = actual === rutaEjemplo;

// La marca es un hemiciclo en pequeño: tres arcos de escaños.
const marca = renderHemiciclo({ total: 24, filas: 3, grupos: [{ nombre: 'Escaños', color: 'currentColor', escanos: 24 }] });

// Sin ID de AdSense no hay nada. Solo con el ID (modo verificación) va la etiqueta `meta` y ningún script de terceros.
// Con anuncios, la ley exige identificar al titular.
const config = ANUNCIOS();
const anuncios = muestraAnuncios(config) ? config : null;
if (anuncios) exigirTitular(titularJson);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo} · Elecciones España</title>
    <meta name="description" content={descripcion} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href={ruta('/favicon.svg')} type="image/svg+xml" />
    {config && <meta name="google-adsense-account" content={config.cliente} />}
    {anuncios && <script async src={urlScriptAnuncios(anuncios.cliente)} crossorigin="anonymous" is:inline />}
  </head>
  <body data-fase={fase} data-portada={portada ? 'true' : 'false'} data-base={inicio} data-ancho-laterales={ANCHO_MINIMO_LATERALES}>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <header class="cabecera">
      <div class="contenedor">
        <a class="marca" href={inicio}><Fragment set:html={marca} />Elecciones España</a>
        <nav class="nav" aria-label="Principal">
          <a class="nav-extra" href={rutaEjemplo} aria-current={enEjemplo ? 'page' : undefined}>Ejemplo de recuento</a>
          <a href={rutaHistorico} aria-current={enHistorico ? 'page' : undefined}>Histórico</a>
        </nav>
        <span class="fase-actual" data-fase={fase}><span class="punto" aria-hidden="true"></span>{etiquetaFase[fase]}</span>
      </div>
    </header>

    <main id="contenido">
      <div class="contenedor">
        <slot />
      </div>
    </main>

    {
      anuncios && (
        <div class="contenedor">
          <Anuncio config={anuncios} tipo="pie" />
        </div>
      )
    }
    {
      anuncios?.huecoLateral && (
        <>
          <Anuncio config={anuncios} tipo="lateral" lado="izquierdo" />
          <Anuncio config={anuncios} tipo="lateral" lado="derecho" />
        </>
      )
    }

    <footer class="pie">
      <div class="contenedor">
        <div>
          <p class="pie-marca"><Fragment set:html={marca} />Elecciones España</p>
          <p>
            Proyecto independiente, sin vinculación oficial con el Ministerio del Interior ni con la Junta Electoral Central.
          </p>
        </div>
        <ul>
          <li><a href={rutaEjemplo}>Ejemplo de recuento</a></li>
          <li><a href={rutaHistorico}>Histórico</a></li>
          <li><a href={ruta('privacidad/')}>Privacidad y aviso legal</a></li>
          {
            anuncios && (
              <li data-preferencias-publicidad hidden>
                <button type="button" class="enlace">
                  Preferencias de publicidad
                </button>
              </li>
            )
          }
        </ul>
      </div>
    </footer>

    <script id="calendario" type="application/json" is:inline set:html={JSON.stringify(CALENDARIO)} />
    <script>
      import '../scripts/cliente';
      import '../scripts/anuncios';
    </script>
  </body>
</html>
